{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orbit-s3",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "services": [
    { "binding": "CONTROL_PLANE", "service": "orbit-api", "entrypoint": "ControlPlane" },
    { "binding": "API", "service": "orbit-api" },
    { "binding": "DATA_PLANE", "service": "orbit-data-plane" }
  ],
  "durable_objects": { "bindings": [{ "name": "S3_STATE", "class_name": "S3State" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["S3State"] }],
  "vars": {
    "ULS_ISSUER": "http://127.0.0.1:8788",
    "ULS_S3_HOST": "s3.orbit.com",
    "ULS_DATA_ENDPOINT": "http://127.0.0.1:8787"
  },
  "secrets": { "required": ["ULS_JWT_PRIVATE_JWK"] },
  "env": {
    "production": {
      "name": "orbit-s3",
      "secrets": { "required": ["ULS_JWT_PRIVATE_JWK"] },
      "workers_dev": true,
      "preview_urls": false,
      "services": [
        { "binding": "CONTROL_PLANE", "service": "orbit-api", "entrypoint": "ControlPlane" },
        { "binding": "API", "service": "orbit-api" },
        { "binding": "DATA_PLANE", "service": "orbit-data-plane" }
      ],
      "durable_objects": { "bindings": [{ "name": "S3_STATE", "class_name": "S3State" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["S3State"] }],
      "vars": {
        "ULS_ISSUER": "https://orbit-api.__WORKERS_DOMAIN__",
        "ULS_S3_HOST": "orbit-s3.__WORKERS_DOMAIN__",
        "ULS_DATA_ENDPOINT": "https://orbit-data-plane.__WORKERS_DOMAIN__"
      }
    }
  }
}
