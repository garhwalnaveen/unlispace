{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022"], "types": ["@cloudflare/vitest-plugin/types", "node"],
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "skipLibCheck": true, "isolatedModules": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["worker-configuration.d.ts", "src", "test", "vitest.config.ts"]
}
