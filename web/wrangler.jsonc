{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "orbit-web",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "env": {
    "production": {
      "name": "orbit-web",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
    }
  },
}
